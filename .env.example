# Entorno
APP_ENV=production
APP_PORT=8000
TZ=Europe/Madrid

# PostgreSQL: use valores aleatorios distintos en cada instalación
POSTGRES_DB=confeccion
POSTGRES_USER=confeccion
POSTGRES_PASSWORD=REEMPLAZAR_CON_UN_SECRETO_DE_32_CARACTERES

# Sesiones: genere, por ejemplo, con `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SESSION_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
SESSION_HOURS=12
COOKIE_HTTPS_ONLY=true

# Hosts públicos separados por coma. Incluya el dominio de Coolify/Dokploy.
ALLOWED_HOSTS=confeccion.example.com,localhost,127.0.0.1
DOCS_ENABLED=false

# Proxy de confianza para Uvicorn. En la red Docker, normalmente es "*"; restrínjalo
# a la red/proxy de su plataforma cuando conozca su dirección.
FORWARDED_ALLOW_IPS=*

# Seguridad y límites
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
MAX_REQUEST_BYTES=5242880

# Bootstrap explícito. Solo lo usa `python -m app.cli create-admin`.
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Administrador
ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_ADMIN_DE_16_CARACTERES

# Copias
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
