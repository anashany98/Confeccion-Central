# Debug / temp scripts from one-off fixes (e.g. encoding recovery).
# Real E2E tests live in artifacts/test_*.cjs and stay tracked.
artifacts/analyze_*.py
artifacts/check_*.py
artifacts/decode_*.py
artifacts/debug_*.py
artifacts/debug_*.cjs
artifacts/dump_*.py
artifacts/find_*.py
artifacts/fix_*.py
artifacts/final_*.py
artifacts/final-*.png
artifacts/snap_*.cjs
artifacts/verify*.py
artifacts/*.txt

# Secretos locales de desarrollo (persistidos por app/config.py en dev para
# sobrevivir a reinicios; los reemplaza la variable SESSION_SECRET en prod).
.secrets/

# Capturas de pantalla y logs de las pruebas GUI locales.
gui-test-screenshots/

# Caché de la herramienta CLI de ZCode (no parte del proyecto).
.zcode/

# Sidecars de SQLite (sólo en dev; en prod se usa Postgres por volúmenes).
confeccion.db-journal
confeccion.db-shm
confeccion.db-wal
